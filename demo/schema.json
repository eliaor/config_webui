{
    "title": "Application Global Configuration",
    "type": "object",
    "properties": {
        "user_credential": {
            "title": "User Credential",
            "type": "object",
            "properties": {
                "username": {
                    "title": "Username",
                    "type": "string",
                    "minLength": 1,
                    "default": "Alice"
                },
                "password": {
                    "title": "Password",
                    "type": "string",
                    "format": "password",
                    "description": "Password must be at least 8 characters long.",
                    "minLength": 8,
                    "default": "Alice_123456"
                }
            },
            "required": [
                "username",
                "password"
            ]
        },
        "applicant_information": {
            "title": "Applicant Information",
            "type": "object",
            "properties": {
                "name": {
                    "title": "Name",
                    "type": "string",
                    "minLength": 1,
                    "default": "Alice Smith"
                },
                "age": {
                    "title": "Age",
                    "type": "integer",
                    "default": 28
                },
                "gender": {
                    "title": "Gender",
                    "type": "string",
                    "enum": [
                        "Male",
                        "Female",
                        "Other"
                    ],
                    "default": "Female"
                },
                "email": {
                    "title": "Email",
                    "type": "string",
                    "format": "email",
                    "default": "alice.smith@example.com"
                },
                "phone": {
                    "title": "Phone",
                    "type": "string",
                    "default": "+1 5551234567"
                }
            },
            "required": [
                "name",
                "age",
                "email"
            ]
        },
        "reservation_detail": {
            "title": "Reservation Detail",
            "type": "object",
            "properties": {
                "reservation_date": {
                    "type": "string",
                    "title": "Reservation Date",
                    "format": "date",
                    "default": "2026-09-15"
                },
                "reservation_time_start": {
                    "type": "string",
                    "title": "Reservation Time (start)",
                    "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                    "description": "24-hour format, e.g., 09:00",
                    "default": "09:00"
                },
                "reservation_time_end": {
                    "type": "string",
                    "title": "Reservation Time (end)",
                    "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                    "description": "24-hour format, e.g., 11:30",
                    "default": "11:30"
                },
                "reservation_purpose": {
                    "type": "array",
                    "title": "Reservation Purpose",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": [
                            "Visit",
                            "Consult",
                            "Testing",
                            "Interview"
                        ]
                    },
                    "default": [
                        "Consult",
                        "Testing"
                    ]
                },
                "notes": {
                    "type": "string",
                    "title": "Notes",
                    "default": "Looking forward to the meeting."
                }
            },
            "required": [
                "reservation_date",
                "reservation_time_start",
                "reservation_time_end",
                "reservation_purpose"
            ]
        },
        "system_settings": {
            "title": "System & Admin Settings (Read-Only)",
            "type": "object",
            "properties": {
                "system_id": {
                    "title": "System ID",
                    "type": "string",
                    "readOnly": true,
                    "default": "SYS-PROD-2026-08"
                },
                "server_environment": {
                    "title": "Server Environment",
                    "type": "string",
                    "readOnly": true,
                    "default": "Production"
                },
                "max_reservations_per_day": {
                    "title": "Max Reservations Per Day",
                    "type": "integer",
                    "readOnly": true,
                    "default": 100
                },
                "admin_access_token": {
                    "title": "Admin Access Token",
                    "type": "string",
                    "readOnly": true,
                    "default": "adm_sec_993881726"
                }
            }
        }
    },
    "required": [
        "user_credential",
        "applicant_information",
        "reservation_detail"
    ]
}