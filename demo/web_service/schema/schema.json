{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web Service Global Configuration",
  "type": "object",
  "properties": {
    "server": {
      "title": "Server & Network Settings",
      "type": "object",
      "properties": {
        "host": {
          "title": "Host Address",
          "type": "string",
          "default": "127.0.0.1",
          "description": "Network interface to bind server"
        },
        "port": {
          "title": "Port Number",
          "type": "integer",
          "default": 8080,
          "minimum": 1,
          "maximum": 65535
        },
        "workers": {
          "title": "Worker Processes",
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 64
        },
        "timeout_seconds": {
          "title": "Timeout (seconds)",
          "type": "number",
          "default": 30.0,
          "minimum": 1.0,
          "maximum": 300.0
        },
        "enable_tls": {
          "title": "Enable TLS / HTTPS",
          "type": "boolean",
          "default": false
        }
      },
      "required": ["host", "port", "workers"]
    },
    "database": {
      "title": "Database Settings",
      "type": "object",
      "properties": {
        "engine": {
          "title": "Database Engine",
          "type": "string",
          "enum": ["sqlite", "postgresql", "mysql"],
          "default": "postgresql"
        },
        "host": {
          "title": "Database Host",
          "type": "string",
          "default": "localhost"
        },
        "port": {
          "title": "Database Port",
          "type": "integer",
          "default": 5432,
          "minimum": 1,
          "maximum": 65535
        },
        "database_name": {
          "title": "Database Name",
          "type": "string",
          "default": "app_production"
        },
        "username": {
          "title": "Username",
          "type": "string",
          "default": "db_user"
        },
        "password": {
          "title": "Password",
          "type": "string",
          "format": "password",
          "default": "super_secret_password"
        },
        "pool_size": {
          "title": "Connection Pool Size",
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": ["engine", "database_name"]
    },
    "caching": {
      "title": "Caching & Sessions",
      "type": "object",
      "options": {
        "collapsed": true
      },
      "properties": {
        "enabled": {
          "title": "Enable Caching",
          "type": "boolean",
          "default": true
        },
        "backend": {
          "title": "Cache Backend",
          "type": "string",
          "enum": ["memory", "redis", "memcached"],
          "default": "redis"
        },
        "redis_url": {
          "title": "Redis URL",
          "type": "string",
          "default": "redis://localhost:6379/0"
        },
        "default_ttl_seconds": {
          "title": "TTL (seconds)",
          "type": "integer",
          "default": 3600,
          "minimum": 0
        }
      },
      "required": ["enabled", "backend"]
    },
    "logging": {
      "title": "Logging & Diagnostics",
      "type": "object",
      "properties": {
        "log_level": {
          "title": "Log Level",
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
          "default": "INFO"
        },
        "log_to_file": {
          "title": "Log to File",
          "type": "boolean",
          "default": true
        },
        "file_path": {
          "title": "Log File Path",
          "type": "string",
          "default": "logs/app.log"
        },
        "json_format": {
          "title": "JSON Format",
          "type": "boolean",
          "default": false
        }
      },
      "required": ["log_level"]
    },
    "features": {
      "title": "Feature Flags",
      "type": "object",
      "options": {
        "collapsed": true
      },
      "properties": {
        "beta_dashboard": {
          "title": "Beta Dashboard",
          "type": "boolean",
          "default": false
        },
        "email_notifications": {
          "title": "Email Notifications",
          "type": "boolean",
          "default": true
        },
        "maintenance_mode": {
          "title": "Maintenance Mode",
          "type": "boolean",
          "default": false
        }
      }
    },
    "system_protected": {
      "title": "System & Admin Controls (Read-Only)",
      "description": "Sensitive infrastructure parameters. Requires Admin Login to edit.",
      "type": "object",
      "options": {
        "collapsed": true
      },
      "properties": {
        "cluster_uuid": {
          "title": "Cluster UUID",
          "type": "string",
          "readOnly": true,
          "default": "CLS-9901-PROD-US-EAST"
        },
        "environment_tier": {
          "title": "Environment Tier",
          "type": "string",
          "readOnly": true,
          "default": "Production"
        },
        "max_requests_per_minute": {
          "title": "Global Rate Limit (RPM)",
          "type": "integer",
          "readOnly": true,
          "default": 10000,
          "minimum": 100
        },
        "license_key": {
          "title": "Enterprise License Key",
          "type": "string",
          "readOnly": true,
          "default": "ENT-2026-X889-Z910-K124"
        }
      },
      "required": ["cluster_uuid", "environment_tier"]
    }
  },
  "required": [
    "server",
    "database",
    "caching",
    "logging",
    "features",
    "system_protected"
  ]
}

